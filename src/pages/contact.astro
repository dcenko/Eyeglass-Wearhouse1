---
import Header from "../components/Header.astro";

const facebookUrl = "https://www.facebook.com/profile.php?id=61588407723104";
const phoneNumber = "614-795-6558";
---

<html lang="en">
  <head>
    <title>Contact | Eyeglass Wearhouse1, LLC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Contact Eyeglass Wearhouse1, LLC for mobile optician services."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="contact-hero">
        <p class="eyebrow">Get In Touch</p>
        <h1>Contact Eyeglass Wearhouse1, LLC</h1>
        <p>
          Have questions about mobile eyeglass services, facility visits, or
          availability? Reach out and we’ll help you get started.
        </p>
      </section>

      <section class="contact-section">
        <div class="contact-card">
          <h2>Contact Information</h2>

          <div class="contact-item">
            <span>Phone</span>
            <a href={`tel:${phoneNumber}`}>{phoneNumber}</a>
          </div>

          <div class="contact-item">
            <span>Facebook</span>
            <a href={facebookUrl} target="_blank">Message us on Facebook</a>
          </div>

          <div class="contact-item">
            <span>Service Type</span>
            <p>Mobile optician visits for homes, facilities, and communities.</p>
          </div>
        </div>

        <div class="contact-card">
          <h2>Request an appointment</h2>

          <form
  class="contact-form"
  action="https://formspree.io/f/xrpzjydd"
  method="POST"
>
  <label>
    Name
    <input type="text" name="name" placeholder="Your name" required />
  </label>

  <label>
    Email
    <input type="email" name="email" placeholder="Your email" required />
  </label>

  <label>
    Phone
    <input type="tel" name="phone" placeholder="Your phone number" />
  </label>

  <label>
    Message
    <textarea
      name="message"
      rows="6"
      placeholder="How can we help?"
      required
    ></textarea>
  </label>

  <input type="hidden" name="_subject" value="New message from Eyeglass Wearhouse1 website" />

  <button type="submit">Send Message</button>
</form>

          <p class="form-note">
            This is a visual form for now. Later we can connect it to email,
            Formspree, Netlify Forms, or a backend.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f7f3ec;
    color: #1f2933;
  }

  a {
    text-decoration: none;
  }

  .contact-hero {
    padding: 5rem 8% 3rem;
    background: linear-gradient(135deg, #17202a, #2d3f50);
    color: white;
  }

  .eyebrow {
    color: #f4c95d;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    margin: 0.5rem 0 1rem;
  }

  .contact-hero p {
    max-width: 720px;
    font-size: 1.15rem;
    color: #e5e7eb;
    line-height: 1.7;
  }

  .contact-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2rem;
    padding: 4rem 8%;
  }

  .contact-card {
    background: white;
    padding: 2rem;
    border-radius: 24px;
    box-shadow: 0 15px 40px rgba(31, 41, 51, 0.08);
  }

  .contact-card h2 {
    margin-top: 0;
    color: #17202a;
  }

  .contact-item {
    padding: 1rem 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .contact-item:last-child {
    border-bottom: none;
  }

  .contact-item span {
    display: block;
    font-weight: 800;
    color: #9a6b12;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  .contact-item a {
    color: #17202a;
    font-weight: 800;
  }

  .contact-item p {
    margin: 0;
    color: #4b5563;
    line-height: 1.6;
  }

  form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-weight: 700;
    color: #17202a;
  }

  input,
  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d1d5db;
    border-radius: 14px;
    padding: 0.9rem 1rem;
    font: inherit;
    background: #fafafa;
  }

  textarea {
    min-height: 130px;
    resize: vertical;
  }

  button {
    border: none;
    border-radius: 999px;
    padding: 0.95rem 1.2rem;
    background: #f4c95d;
    color: #17202a;
    font-weight: 900;
    cursor: pointer;
    font-size: 1rem;
  }

  button:hover {
    transform: translateY(-1px);
  }

  .form-note {
    margin-top: 1rem;
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .contact-section {
      grid-template-columns: 1fr;
      padding: 3rem 6%;
    }

    .contact-hero {
      padding: 4rem 6% 3rem;
    }
  }
</style>