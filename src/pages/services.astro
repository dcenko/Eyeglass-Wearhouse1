---
import Header from "../components/header.astro";

const facebookUrl = "https://www.facebook.com/profile.php?id=61588407723104";
---

<html lang="en">
  <head>
    <title>Services | Eyeglass Wearhouse1, LLC</title>
    <meta
      name="description"
      content="Mobile eyewear services from Eyeglass Wearhouse1, LLC for homes, senior communities, facilities, and local clients."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="services-hero">
        <div class="hero-copy">
          <p class="eyebrow">Services</p>
          <h1>Mobile eyewear service for clients, homes, and facilities.</h1>
          <p>
            Eyeglass Wearhouse1, LLC brings frame selection and eyewear support
            directly to people who need a more convenient way to shop for
            glasses.
          </p>

          <div class="hero-actions">
            <a href="/catalog" class="primary-button">View Catalog</a>
            <a href={facebookUrl} target="_blank" class="secondary-button">
              Message on Facebook
            </a>
          </div>
        </div>

        <div class="hero-card">
          <img src="/logo.jpg" alt="Eyeglass Wearhouse1 LLC logo" />
          <span>Mobile Visits</span>
          <strong>Eyewear service brought closer to you.</strong>
        </div>
      </section>

      <section class="intro-section">
        <div>
          <p class="eyebrow blue">What We Do</p>
          <h2>Convenient eyeglass service without the extra trip.</h2>
        </div>

        <p>
          Many clients cannot easily visit a traditional optical store. We help
          by bringing eyewear options closer to them whether that means a home
          visit, a senior living facility visit, or a scheduled community event.
        </p>
      </section>

      <section class="service-section">
        <div class="section-heading">
          <p class="eyebrow blue">Our Services</p>
          <h2>Support for individuals, families, and facilities.</h2>
        </div>

        <div class="service-grid">
          <article>
            <h3>Mobile Eyeglass Visits</h3>
            <p>
              We can visit homes, facilities, senior communities, and local
              locations to make eyeglass service more accessible.
            </p>
          </article>

          <article>
            <h3>Frame Selection Assistance</h3>
            <p>
              Clients can browse available frames and receive help choosing
              styles based on comfort, fit, daily use, and personal preference.
            </p>
          </article>

          <article>
            <h3>Facility & Group Visits</h3>
            <p>
              A practical option for senior living communities, care centers,
              and organizations that want to serve multiple residents or
              clients.
            </p>
          </article>

          <article>
            <h3>Catalog-Based Shopping</h3>
            <p>
              Frames can be organized by brand, model, gender, price range, and
              color so clients can view options more clearly.
            </p>
          </article>

          <article>
            <h3>Fit & Comfort Guidance</h3>
            <p>
              We help clients think through frame comfort, face shape, bridge
              fit, temple feel, and everyday wear needs.
            </p>
          </article>

          <article>
            <h3>Community Events</h3>
            <p>
              Eyewear service can be coordinated for local outreach events,
              facility days, and community-based appointments.
            </p>
          </article>
        </div>
      </section>

      <section class="experience-section">
        <div class="experience-card">
          <p class="eyebrow">The Experience</p>
          <h2>A simple process from visit to frame selection.</h2>
        </div>

        <div class="steps">
          <div>
            <h3>Schedule</h3>
            <p>
              Contact us to discuss the client, location, facility, or group
              visit.
            </p>
          </div>

          <div>
            <h3>Browse</h3>
            <p>
              View available frame options from the catalog or during the visit.
            </p>
          </div>

          <div>
            <h3>Select</h3>
            <p>
              Choose frames based on comfort, appearance, lifestyle, and budget.
            </p>
          </div>

          <div>
            <h3>Follow Up</h3>
            <p>
              Ask questions, confirm details, or coordinate future service
              through Facebook or the contact page.
            </p>
          </div>
        </div>
      </section>

      <section class="split-section">
        <div class="image-panel">
          <img src="heronew.png" alt="Eyeglass service background" />
        </div>

        <div class="split-copy">
          <p class="eyebrow blue">Facility-Friendly</p>
          <h2>Built for senior communities, care centers, and group needs.</h2>
          <p>
            Instead of asking each client to travel separately, a mobile visit
            can bring eyewear service directly to the facility. That can make
            the process easier for residents, families, staff, and caregivers.
          </p>

          <div class="feature-list">
            <div>
              <strong>Less transportation stress</strong>
              <span>Clients can receive help closer to where they are.</span>
            </div>

            <div>
              <strong>Organized appointment windows</strong>
              <span>Facilities can coordinate service for multiple people.</span>
            </div>

            <div>
              <strong>More personal attention</strong>
              <span>Frame selection can happen in a calmer setting.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="faq-header">
          <p class="eyebrow blue">Questions</p>
          <h2>Common Service Questions</h2>
          <p>
            Quick answers for families, facilities, and clients who want a
            simple way to understand our mobile eyewear service.
          </p>
        </div>

        <div class="faq-list">
          <details class="faq-item">
            <summary>
              <span>Do you travel to facilities?</span>
            </summary>
            <p>
              Yes. The service is designed for mobile visits, including senior
              communities, care facilities, homes, and local locations.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              <span>Can multiple people be seen during one visit?</span>
            </summary>
            <p>
              Yes. Facility or group visits can be coordinated so multiple
              clients can browse options during the same appointment window.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              <span>Can clients browse glasses online first?</span>
            </summary>
            <p>
              Yes. The catalog page can be used to preview frame options by
              brand, model, color, gender, and price range before scheduling a
              visit.
            </p>
          </details>

          <details class="faq-item">
            <summary>
              <span>How do we schedule?</span>
            </summary>
            <p>
              The easiest way for now is to message the business through
              Facebook or use the contact page. We can discuss the location,
              number of clients, and the type of visit needed.
            </p>
          </details>
        </div>
      </section>

      <section class="cta-section">
        <p class="eyebrow">Ready to Start?</p>
        <h2>Ask about a mobile eyewear visit today.</h2>

        <div class="hero-actions center">
          <a href="/contact" class="primary-button">Contact Us</a>
          <a href={facebookUrl} target="_blank" class="secondary-button">
            Facebook Page
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f8f6f0;
    color: #17202a;
  }

  a {
    text-decoration: none;
  }

  .services-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 0.98fr) minmax(360px, 480px);
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
  min-height: 720px;
  padding: 7rem 8% 5.5rem;
  overflow: hidden;
  background:
    linear-gradient(
      90deg,
      rgba(248, 252, 255, 0.97) 0%,
      rgba(248, 252, 255, 0.9) 48%,
      rgba(232, 243, 252, 0.72) 68%,
      rgba(18, 61, 99, 0.24) 100%
    ),
    url("/he.jpg");
  background-size: cover;
  background-position: center;
}

  .services-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 15%, rgba(216, 236, 255, 0.85), transparent 28%),
      radial-gradient(circle at 90% 80%, rgba(31, 95, 148, 0.22), transparent 32%);
    pointer-events: none;
  }

  .hero-copy,
  .hero-card {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #1f5f94;
    font-weight: 950;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  .eyebrow.blue {
    color: #1f5f94;
  }

  h1 {
    max-width: 980px;
    margin: 0;
    color: #123d63;
    font-size: clamp(3.4rem, 7vw, 7.4rem);
    line-height: 0.87;
    letter-spacing: -0.08em;
  }

  .hero-copy p {
    max-width: 720px;
    color: #3f4d5a;
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-actions.center {
    justify-content: center;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 50px;
    padding: 0 1.45rem;
    border-radius: 999px;
    font-weight: 950;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .primary-button {
    background: #1f5f94;
    color: white;
    box-shadow: 0 18px 45px rgba(31, 95, 148, 0.28);
  }

  .secondary-button {
    color: #1f5f94;
    border: 1px solid rgba(31, 95, 148, 0.3);
    background: rgba(255, 255, 255, 0.64);
    backdrop-filter: blur(14px);
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  .hero-card {
  max-width: 520px;
  min-height: 340px;
  padding: 2.6rem 2.8rem;
  border-radius: 34px;
  background: rgba(255, 255, 255, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 28px 80px rgba(22, 72, 112, 0.16);
  backdrop-filter: blur(18px);
  transform: translateY(-35px);
}

  @media (max-width: 900px) {
  .hero-card {
    transform: none;
  }
}

  .hero-card img {
    width: 180px;
    max-width: 80%;
    display: block;
    padding: 1rem;
    border-radius: 26px;
    background: white;
    margin-bottom: 2rem;
    box-shadow: inset 0 0 0 1px rgba(31, 95, 148, 0.08);
  }

  .hero-card span {
    color: #1f5f94;
    font-weight: 950;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
  }

  .hero-card strong {
    display: block;
    margin-top: 0.8rem;
    color: #123d63;
    font-size: 2.25rem;
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .intro-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: start;
    padding: 6rem 8%;
    background: white;
  }

  .intro-section h2,
  .section-heading h2,
  .experience-card h2,
  .split-copy h2,
  .cta-section h2 {
    margin: 0;
    color: #17202a;
    font-size: clamp(2.7rem, 5vw, 5.2rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .intro-section > p,
  .split-copy p {
    color: #52606d;
    font-size: 1.15rem;
    line-height: 1.9;
  }

  .service-section,
  .faq-section {
    padding: 6rem 8%;
  }

  .section-heading {
    max-width: 980px;
    margin-bottom: 3rem;
  }

  .section-heading.centered {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .service-grid article {
    position: relative;
    min-height: 280px;
    padding: 2rem;
    overflow: hidden;
    border-radius: 34px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.74)),
      radial-gradient(circle at 90% 10%, rgba(216, 236, 255, 0.75), transparent 36%);
    border: 1px solid rgba(31, 95, 148, 0.08);
    box-shadow: 0 20px 60px rgba(31, 95, 148, 0.08);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  .service-grid article::after {
    content: "";
    position: absolute;
    right: -45px;
    bottom: -45px;
    width: 130px;
    height: 130px;
    border-radius: 999px;
    border: 22px solid rgba(31, 95, 148, 0.06);
  }

  .service-grid article:hover {
    transform: translateY(-7px);
    box-shadow: 0 34px 90px rgba(31, 95, 148, 0.16);
  }

  .service-grid article span,
  .steps span {
    color: #1f5f94;
    font-weight: 950;
    letter-spacing: 0.14em;
  }

  .service-grid h3,
  .steps h3 {
    color: #17202a;
    font-size: 1.45rem;
    margin: 1rem 0;
    letter-spacing: -0.04em;
  }

  .service-grid p,
  .steps p,
  .feature-list span,
  .faq-grid p {
    color: #52606d;
    line-height: 1.75;
  }

  .experience-section {
    position: relative;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 3rem;
    padding: 6rem 8%;
    overflow: hidden;
    background:
      radial-gradient(circle at 10% 20%, rgba(216, 236, 255, 0.2), transparent 28%),
      linear-gradient(135deg, #123d63, #1f5f94);
    color: white;
  }

  .experience-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent);
  }

  .experience-card,
  .steps {
    position: relative;
    z-index: 1;
  }

  .experience-card h2 {
    color: white;
  }

  .experience-card .eyebrow {
    color: #d8ecff;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .steps div {
    padding: 1.6rem;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(16px);
  }

  .steps span,
  .steps p {
    color: #d8ecff;
  }

  .steps h3 {
    color: white;
  }

  .split-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: center;
    padding: 6rem 8%;
    background: #f8f6f0;
  }

  .image-panel {
    overflow: hidden;
    border-radius: 42px;
    min-height: 520px;
    background: white;
    box-shadow: 0 28px 90px rgba(31, 95, 148, 0.13);
  }

  .image-panel img {
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
  }

  .feature-list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .feature-list div {
    padding: 1.25rem 1.35rem;
    border-radius: 24px;
    background: white;
    border: 1px solid rgba(31, 95, 148, 0.08);
    box-shadow: 0 16px 42px rgba(31, 95, 148, 0.07);
  }

  .feature-list strong {
    display: block;
    color: #1f5f94;
    margin-bottom: 0.4rem;
    font-size: 1.05rem;
  }

  .faq-section {
    position: relative;
    padding: 6rem 8%;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(216, 236, 255, 0.7), transparent 30%),
      radial-gradient(circle at 88% 82%, rgba(244, 201, 93, 0.22), transparent 30%),
      linear-gradient(135deg, #f8f6f0, #eef6fc);
  }

  .faq-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(31, 95, 148, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31, 95, 148, 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
    pointer-events: none;
  }

  .faq-header,
  .faq-list {
    position: relative;
    z-index: 1;
  }

  .faq-header {
    max-width: 820px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .faq-header h2 {
    margin: 0;
    color: #123d63;
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .faq-header p {
    max-width: 680px;
    margin: 1rem auto 0;
    color: #52606d;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .faq-list {
    display: grid;
    gap: 1rem;
    max-width: 940px;
    margin: 0 auto;
  }

  .faq-item {
    overflow: hidden;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(31, 95, 148, 0.12);
    box-shadow: 0 18px 50px rgba(31, 95, 148, 0.08);
    backdrop-filter: blur(16px);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease;
  }

  .faq-item:hover {
    transform: translateY(-4px);
    border-color: rgba(31, 95, 148, 0.28);
    box-shadow: 0 30px 80px rgba(31, 95, 148, 0.16);
    background: white;
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.5rem;
    list-style: none;
    cursor: pointer;
    color: #17202a;
    font-size: 1.12rem;
    font-weight: 950;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary strong {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 999px;
    background: #1f5f94;
    color: white;
    font-size: 1.35rem;
    line-height: 1;
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      color 0.22s ease;
  }

  .faq-item[open] {
    background: white;
    border-color: rgba(244, 201, 93, 0.7);
  }

  .faq-item[open] summary strong {
    transform: rotate(45deg);
    background: #f4c95d;
    color: #123d63;
  }

  .faq-item p {
    margin: 0;
    padding: 0 1.5rem 1.5rem;
    color: #52606d;
    line-height: 1.8;
    animation: faqFade 0.24s ease;
  }

  @keyframes faqFade {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cta-section {
    position: relative;
    padding: 6rem 8%;
    text-align: center;
    overflow: hidden;
    background:
      linear-gradient(rgba(18, 61, 99, 0.82), rgba(18, 61, 99, 0.82)),
      url("/heronew.png");
    background-size: cover;
    background-position: center;
    color: white;
  }

  .cta-section h2 {
    max-width: 920px;
    margin-left: auto;
    margin-right: auto;
    color: white;
  }

  .cta-section .eyebrow {
    color: #d8ecff;
  }

  .cta-section .primary-button {
    background: white;
    color: #1f5f94;
  }

  .cta-section .secondary-button {
    color: white;
  }

  @media (max-width: 1050px) {
    .services-hero,
    .intro-section,
    .experience-section,
    .split-section {
      grid-template-columns: 1fr;
    }

    .hero-card {
      justify-self: start;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .services-hero,
    .intro-section,
    .service-section,
    .experience-section,
    .split-section,
    .faq-section,
    .cta-section {
      padding-left: 6%;
      padding-right: 6%;
    }

    .service-grid,
    .steps {
      grid-template-columns: 1fr;
    }

    .image-panel,
    .image-panel img {
      min-height: 320px;
    }

    h1 {
      font-size: clamp(3rem, 16vw, 5rem);
    }

    .faq-header h2 {
      font-size: clamp(2.5rem, 13vw, 4rem);
    }

    .faq-item summary {
      font-size: 1rem;
      padding: 1.15rem 1.2rem;
    }

    .faq-item p {
      padding: 0 1.2rem 1.2rem;
    }
  }

  
</style>