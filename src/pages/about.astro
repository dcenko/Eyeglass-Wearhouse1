---
import Header from "../components/Header.astro";

const facebookUrl = "https://www.facebook.com/profile.php?id=61588407723104";
const InstagramUrl = "https://www.instagram.com/eyeglass_wearhouse1_llc/";
---

<html lang="en">
  <head>
    <title>About Us | Eyeglass Wearhouse1, LLC</title>
    <meta
      name="description"
      content="Meet Eyeglass Wearhouse1, LLC, a mobile optician service bringing frame styling, eyewear fittings, and personal optical care directly to you."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="about-hero">
        <div class="hero-copy">
          <p class="eyebrow">About Us</p>

          <h1>Vision care made personal, convenient, and close to home.</h1>

          <p>
            Eltjon is an accomplished optical professional with 25 years of
            experience, beginning his career in Albania and with a degree as a
            doctor of optometry, and continuing his education in Italy for the
            field of opticianry. An ABO certified optician and certified and
            licensed by the state of Ohio, he is committed to helping revitalize
            the optical landscape through education, mentorship, and now,
            business. His background also includes optometric teaching, adult
            technical training and retail management. He is dedicated to making
            meaningful contributions to the optical community and is known for
            his excellent communication skills, adaptability, and upbeat
            presence.
          </p>

          <div class="hero-actions">
            <a href="/contact" class="primary-btn">Book an Appointment</a>
            <a href={facebookUrl} target="_blank" rel="noreferrer" class="secondary-btn">
              Message Us
            </a>
          </div>
        </div>

        <div class="hero-photo-card">
          <img
            src="/glasses/Toni_hero.png"
            alt="Mobile optician from Eyeglass Wearhouse1, LLC"
          />
        </div>
      </section>

      <section class="intro-section">
        <div class="section-label">Meet Your Mobile Optician</div>

        <div class="intro-grid">
          <div>
            <h2>Professional eyewear help, without the rush.</h2>
          </div>

          <div class="intro-text">
            <p>
              At Eyeglass Wearhouse1, LLC, we believe choosing glasses should
              feel clear, relaxed, and personal. Our mobile optician service is
              designed for busy professionals, parents, seniors, caregivers,
              families, and anyone who wants quality eyewear guidance without
              the stress of traveling to a store.
            </p>

            <p>
              We help clients compare frames, understand fit, choose styles that
              match their face and lifestyle, and feel confident before making a
              decision. Every appointment is built around convenience,
              communication, and one-on-one service.
            </p>
          </div>
        </div>
      </section>

      <section class="values-section">
        <div class="value-card">
          <span>Gratitude</span>
          <p>
            We honor the trust people place in us by showing up with care,
            respect, and appreciation for every community we serve.
          </p>
        </div>

        <div class="value-card">
          <span>Access</span>
          <p>
            We remove the barriers that keep people from getting the eyewear
            they need by bringing vision care directly to them.
          </p>
        </div>

        <div class="value-card">
          <span>Inclusivity</span>
          <p>
            We welcome every age, every background, every insurance plan, and
            every community. No one is left out of clear vision.
          </p>
        </div>
      </section>

      <section class="story-section">
        <div class="story-card">
          <p class="eyebrow dark">Our Promise</p>

          <h2>Your vision. Our priority.</h2>

          <p>
            Whether we are helping a child replace broken glasses at school,
            supporting employees during a workplace wellness day, or serving
            seniors and families in underserved neighborhoods, Eyeglass
            Wearhouse1 delivers a warm, reliable, and convenient optical
            experience right where people already are.
          </p>

          <div class="promise-list">
            <div>
              <strong>One-on-one attention</strong>
              <span>No crowded store, no rushed decisions.</span>
            </div>

            <div>
              <strong>Comfortable appointments</strong>
              <span>Eyewear service at your location and on your schedule.</span>
            </div>

            <div>
              <strong>Style with purpose</strong>
              <span>Frames selected for comfort, appearance, and daily use.</span>
            </div>
          </div>
        </div>
      </section>

      <section class="cta-section">
        <p class="eyebrow">Ready when you are</p>

        <h2>Let us bring the eyewear experience to you.</h2>

        <p>
          Schedule a private appointment and discover a more convenient way to
          choose your next pair of glasses.
        </p>

        <div class="cta-actions">
          <a href="/contact" class="primary-btn">Contact Us</a>
          <a href={InstagramUrl} target="_blank" rel="noreferrer" class="secondary-btn dark-btn">
            Instagram
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f7f3ec;
    color: #17202a;
  }

  a {
    text-decoration: none;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 520px);
    gap: 3rem;
    align-items: center;
    padding: 5rem 8%;
    background:
      radial-gradient(circle at 80% 15%, rgba(244, 201, 93, 0.22), transparent 28%),
      linear-gradient(135deg, #101923, #223443);
    color: white;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #f4c95d;
    font-weight: 900;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .eyebrow.dark {
    color: #a66f08;
  }

  .hero-copy h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  .hero-copy p {
    max-width: 680px;
    color: #dbe4ec;
    font-size: 1.12rem;
    line-height: 1.8;
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .cta-actions {
    justify-content: center;
  }

  .primary-btn,
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.95rem 1.35rem;
    font-weight: 950;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .primary-btn {
    background: #f4c95d;
    color: #17202a;
  }

  .primary-btn:hover,
  .secondary-btn:hover {
    transform: translateY(-2px);
    background: white;
    color: #17202a;
  }

  .secondary-btn {
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .dark-btn {
    color: #17202a;
    border-color: rgba(23, 32, 42, 0.16);
    background: #f7f3ec;
  }

  .hero-photo-card {
    width: 100%;
    border-radius: 34px;
    overflow: hidden;
    background: white;
    box-shadow: 0 35px 100px rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero-photo-card img {
    width: 100%;
    height: 680px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .intro-section,
  .story-section,
  .cta-section {
    padding: 5rem 8%;
  }

  .section-label {
    margin-bottom: 1.5rem;
    color: #a66f08;
    font-size: 0.82rem;
    font-weight: 950;
    text-transform: uppercase;
    letter-spacing: 0.24em;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
  }

  .intro-grid h2,
  .story-card h2,
  .cta-section h2 {
    margin: 0;
    color: #17202a;
    font-size: clamp(2.4rem, 4.5vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .intro-text p,
  .story-card p,
  .cta-section p {
    color: #4b5563;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .values-section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 0 8% 5rem;
  }

  .value-card {
    padding: 2rem;
    border-radius: 30px;
    background: white;
    border: 1px solid rgba(31, 95, 148, 0.08);
    box-shadow: 0 20px 60px rgba(31, 41, 51, 0.08);
  }

  .value-card span {
    color: #2e4de8;
    font-size: 2.2rem;
    font-weight: 950;
  }

  .value-card p {
    margin: 1rem 0 0;
    color: #5f6b76;
    line-height: 1.7;
  }

  .story-section {
    background:
      radial-gradient(circle at 15% 20%, rgba(244, 201, 93, 0.18), transparent 26%),
      #efe8dc;
  }

  .story-card {
    max-width: 980px;
    padding: 3rem;
    border-radius: 38px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 24px 80px rgba(31, 41, 51, 0.1);
  }

  .promise-list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .promise-list div {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid #e3d8c8;
  }

  .promise-list strong {
    color: #17202a;
    font-size: 1rem;
  }

  .promise-list span {
    color: #5f6b76;
  }

  .cta-section {
    text-align: center;
    background: white;
  }

  .cta-section p {
    max-width: 680px;
    margin: 1rem auto 0;
  }

  @media (max-width: 900px) {
    .about-hero,
    .intro-grid,
    .values-section {
      grid-template-columns: 1fr;
    }

    .about-hero {
      padding: 4rem 5% 5rem;
      gap: 2.5rem;
    }

    .hero-copy h1 {
      font-size: clamp(3rem, 13vw, 5rem);
    }

    .hero-copy p {
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .hero-photo-card {
      width: calc(100% + 2rem);
      max-width: none;
      margin-left: -1rem;
      margin-right: -1rem;
      height: 560px;
      min-height: 560px;
      border-radius: 30px;
      background:
        radial-gradient(circle at center, #ffffff 0%, #f2f6f9 72%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
    }

    .hero-photo-card img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center top;
      display: block;
    }

    .intro-section,
    .story-section,
    .cta-section {
      padding: 4rem 6%;
    }

    .values-section {
      padding: 0 6% 4rem;
    }
  }

  @media (max-width: 500px) {
    .about-hero {
      padding: 3.5rem 4% 4.5rem;
    }

    .hero-photo-card {
      width: calc(100% + 2.5rem);
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      height: 520px;
      min-height: 520px;
      padding: 0.35rem;
    }

    .hero-photo-card img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center top;
    }

    .story-card {
      padding: 2rem;
      border-radius: 30px;
    }

    .value-card span {
      font-size: 1.8rem;
    }
  }

@media (max-width: 900px) {
  .about-hero {
    grid-template-columns: 1fr;
    padding: 4rem 4% 5rem;
    gap: 2.5rem;
  }

  .hero-photo-card {
    width: calc(100% + 2rem);
    max-width: none;
    margin-left: -1rem;
    margin-right: -1rem;
    height: auto;
    min-height: auto;
    border-radius: 28px;
    padding: 0;
    overflow: hidden;
  }

  .hero-photo-card img {
    width: 100%;
    height: auto;
    min-height: 0;
    max-height: none;
    object-fit: contain;
    object-position: center top;
    display: block;
  }
}

@media (max-width: 500px) {
  .about-hero {
    padding-left: 2.5%;
    padding-right: 2.5%;
  }

  .hero-photo-card {
    width: calc(100% + 3rem);
    margin-left: -1.5rem;
    margin-right: -1.5rem;
  }
}

@media (max-width: 800px) {
  .about-hero {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 4rem 7%;
  }

  .about-copy {
    max-width: 100%;
  }

  .about-copy h1 {
    font-size: clamp(3rem, 15vw, 4.7rem);
    line-height: 0.92;
  }

  .about-copy p {
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.7;
  }

  .about-image {
    width: 100%;
    max-width: 430px;
    margin: 0 auto;
  }

  .about-image img {
    width: 100%;
    height: auto;
    display: block;
  }
}

</style>