<html lang="en">
  <head>
    <title>Catalog | Eyeglass Wearhouse1, LLC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Browse eyeglass brands and frame options from Eyeglass Wearhouse1, LLC."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="catalog-top">
        <div>
          <p class="eyebrow">Catalog</p>
          <h1>Browse Frames</h1>
          <p>
            Search for the glasses you desire
          </p>
        </div>
      </section>

      <section class="catalog-layout">


      <details class="sidebar filter-panel">
  <summary>
    <span>Filter Frames</span>
    <small>Brand & price</small>
  </summary>

  <div class="filter-block">
    <div class="filter-title">
      <h2>Brand</h2>
      <button type="button" class="clear-btn" id="clearFilters">
        Clear
      </button>
    </div>

    <div class="filter-list">
      {
        brands.map((brand) => (
          <label>
            <input type="checkbox" value={brand} data-filter="brand" />
            <span>{brand}</span>
          </label>
        ))
      }
    </div>
  </div>

  <div class="filter-block">
    <h2>Price</h2>

    <div class="filter-list">
      <label>
        <input type="checkbox" value="under150" data-filter="price" />
        <span>Under $150</span>
      </label>

      <label>
        <input type="checkbox" value="150to240" data-filter="price" />
        <span>$150 - $240</span>
      </label>

      <label>
        <input type="checkbox" value="over240" data-filter="price" />
        <span>Over $240</span>
      </label>
    </div>
  </div>
</details>
        

        <section class="products-area">
          <div class="toolbar">
            <div class="search-wrap">
              <input
                type="search"
                id="searchInput"
                placeholder="Search by brand, model, or keyword"
              />
            </div>

            <div class="sort-wrap">
              <label for="sortSelect">Sort By</label>
              <select id="sortSelect">
                <option value="featured">Featured</option>
                <option value="priceLow">Price: Low to High</option>
                <option value="priceHigh">Price: High to Low</option>
                <option value="brandAZ">Brand: A-Z</option>
              </select>
            </div>
          </div>

          <div class="results-line">
            <span id="resultCount">{products.length}</span> frames available
          </div>

          <div class="product-grid" id="productGrid">
            {
              products.map((product) => (
                <article
                  class="product-card"
                  data-brand={product.brand}
                  data-gender={product.gender}
                  data-price={product.price}
                  data-search={`${product.brand} ${product.name} ${product.model} ${product.type} ${product.color}`}
                >
                  <div class="product-image">
{
  product.image ? (
    <img src={product.image} alt={`${product.brand} ${product.model}`} />
  ) : (
    <div class="missing-image">
      <span>{product.brand}</span>
      <strong>{product.model || "Frame"}</strong>
      <small>Image coming soon</small>
    </div>
  )
}</div>

                  <div class="product-info">
                    <p class="brand-name">{product.brand}</p>
                    <h3>{product.model || product.name}</h3>
                    <div class="product-meta">
                      <span>{product.brand}</span>
                      <span>{product.type}</span>
                    </div>

                    <div class="details">
                      <div>
                        <small>Color</small>
                        <strong>{product.color}</strong>
                      </div>

                      <div>
                        <small>Gender</small>
                        <strong>{product.gender}</strong>
                      </div>
                    </div>

                    <div class="product-footer">
                      <strong>${product.price}</strong>
                      <a href={facebookUrl} target="_blank">
                        Ask About This
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <p class="empty-message" id="emptyMessage">
            No frames match those filters.
          </p>
        </section>
      </section>
    </main>

    <script>
  const checkboxes = Array.from(
    document.querySelectorAll("input[type='checkbox']")
  );
  const searchInput = document.querySelector("#searchInput");
  const sortSelect = document.querySelector("#sortSelect");
  const clearButton = document.querySelector("#clearFilters");
  const productGrid = document.querySelector("#productGrid");
  const cards = Array.from(document.querySelectorAll(".product-card"));
  const resultCount = document.querySelector("#resultCount");
  const emptyMessage = document.querySelector("#emptyMessage");

  function getCheckedValues(filterName) {
    return checkboxes
      .filter((checkbox) => checkbox.dataset.filter === filterName)
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => checkbox.value);
  }

  function matchesPrice(card, selectedPrices) {
    if (selectedPrices.length === 0) return true;

    const price = Number(card.dataset.price);

    return selectedPrices.some((range) => {
      if (range === "under150") return price < 150;
      if (range === "150to240") return price >= 150 && price <= 240;
      if (range === "over240") return price > 240;
      return true;
    });
  }

  function sortCards(visibleCards) {
    const sortValue = sortSelect.value;

    return visibleCards.sort((a, b) => {
      const priceA = Number(a.dataset.price);
      const priceB = Number(b.dataset.price);
      const brandA = a.dataset.brand || "";
      const brandB = b.dataset.brand || "";

      if (sortValue === "priceLow") return priceA - priceB;
      if (sortValue === "priceHigh") return priceB - priceA;
      if (sortValue === "brandAZ") return brandA.localeCompare(brandB);

      return 0;
    });
  }

  function applyFilters() {
    const selectedBrands = getCheckedValues("brand");
    const selectedPrices = getCheckedValues("price");
    const searchTerm = searchInput.value.toLowerCase().trim();

    let visibleCards = cards.filter((card) => {
      const matchesBrand =
        selectedBrands.length === 0 ||
        selectedBrands.includes(card.dataset.brand);

      const matchesSearch =
        searchTerm.length === 0 ||
        card.dataset.search.toLowerCase().includes(searchTerm);

      return (
        matchesBrand &&
        matchesPrice(card, selectedPrices) &&
        matchesSearch
      );
    });

    cards.forEach((card) => {
      card.style.display = "none";
    });

    visibleCards = sortCards(visibleCards);

    visibleCards.forEach((card) => {
      card.style.display = "block";
      productGrid.appendChild(card);
    });

    resultCount.textContent = visibleCards.length;
    emptyMessage.style.display =
      visibleCards.length === 0 ? "block" : "none";
  }

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener("change", applyFilters);
  });

  searchInput.addEventListener("input", applyFilters);
  sortSelect.addEventListener("change", applyFilters);

  clearButton.addEventListener("click", () => {
    checkboxes.forEach((checkbox) => {
      checkbox.checked = false;
    });

    searchInput.value = "";
    sortSelect.value = "featured";

    applyFilters();
  });

  applyFilters();
</script>

       
  </body>
</html>

<style>

.brand-count-section {
  padding: 3rem 8% 1rem;
  background: #f7f3ec;
}

.brand-count-header {
  margin-bottom: 1.5rem;
}

.brand-count-header h2 {
  margin: 0;
  color: #17202a;
  font-size: clamp(2rem, 4vw, 3.5rem);
  letter-spacing: -0.05em;
}

.brand-count-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
}

.brand-count-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.2rem;
  border-radius: 18px;
  background: white;
  box-shadow: 0 12px 34px rgba(31, 95, 148, 0.08);
  border: 1px solid rgba(31, 95, 148, 0.08);
}

.brand-count-card span {
  color: #4b5563;
  font-weight: 800;
}

.brand-count-card strong {
  color: #1f5f94;
  font-size: 1.5rem;
  font-weight: 950;
}

@media (max-width: 1100px) {
  .brand-count-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 700px) {
  .brand-count-section {
    padding-left: 6%;
    padding-right: 6%;
  }

  .brand-count-grid {
    grid-template-columns: 1fr;
  }
}
  :global(body) {
    margin: 0;
    font-family:
      Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f7f3ec;
    color: #17202a;
  }

  a {
    text-decoration: none;
  }

  button,
  input,
  select {
    font: inherit;
  }

  .catalog-top {
    padding: 4rem 8% 3rem;
    background:
      radial-gradient(circle at 80% 20%, rgba(244, 201, 93, 0.18), transparent 28%),
      linear-gradient(135deg, #101923, #223443);
    color: white;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #f4c95d;
    font-weight: 900;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .catalog-top p {
    max-width: 720px;
    color: #dbe4ec;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: 270px 1fr;
    gap: 2.5rem;
    padding: 3rem 8% 5rem;
  }

  .sidebar {
  position: sticky;
  top: 110px;
  align-self: start;
  max-height: calc(100vh - 130px);
  overflow-y: auto;
  padding: 1.5rem;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 20px 60px rgba(31, 41, 51, 0.08);
  backdrop-filter: blur(18px);
}


  .sidebar::-webkit-scrollbar {
  width: 8px;
}

.sidebar::-webkit-scrollbar-track {
  background: transparent;
