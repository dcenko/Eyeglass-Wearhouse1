---
const facebookUrl = "https://www.facebook.com/profile.php?id=61588407723104";
const InstagramUrl = "https://www.instagram.com/eyeglass_wearhouse1_llc/";
---

<header class="site-header">
  <a href="/" class="logo">
  <img src="/logo.jpg" alt="Eyeglass Wearhouse1 LLC logo" />
  <span>Eyeglass Wearhouse1, LLC</span>
</a>

  <nav>
    <a href="/">Home</a>
    <a href="/catalog">Catalog</a>
    <a href="/contact">Contact</a>
    <a href="/services">Services</a>
    <a href="/about">About Us</a>
    <a href="/faq">FAQ </a>
  </nav>
</header>

<style>
  .site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 8%;
  background: linear-gradient(135deg, #123d63, #1f5f94);
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 24px rgba(31, 95, 148, 0.22);
}

 .logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: white;
  font-weight: 800;
  font-size: 1.05rem;
  text-decoration: none;
}

.logo img {
  width: 42px;
  height: 42px;
  object-fit: contain;
  border-radius: 10px;
  background: white;
  padding: 0.2rem;
}

  .site-header nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .site-header nav a {
    color: white;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: #f4c95d;
  }

  @media (max-width: 650px) {
    .site-header {
      flex-direction: column;
      gap: 0.75rem;
    }

    .site-header nav {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>