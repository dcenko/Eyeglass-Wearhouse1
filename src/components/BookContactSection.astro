---
const facebookUrl = "https://www.facebook.com/profile.php?id=61588407723104";
const instagramUrl = "https://www.instagram.com/eyeglass_wearhouse1_llc/";
---

<section class="contact">
  <h2>Book or Learn More</h2>
  <p>
    Message us on Facebook or Instagram to ask about availability, facility
    visits, or mobile optician services.
  </p>

  <div class="contact-actions">
    <a href={facebookUrl} target="_blank" class="primary-button">
      Contact Us on Facebook
    </a>

    <a href={instagramUrl} target="_blank" class="primary-button">
      Contact Us on Instagram
    </a>
  </div>
</section>

<style>
  .contact {
    padding: 5.5rem 8%;
    text-align: center;
    background:
      linear-gradient(rgba(18, 61, 99, 0.86), rgba(18, 61, 99, 0.86)),
      url("/hero-bg.jpg");
    background-size: cover;
    background-position: center;
    color: white;
  }

  .contact h2 {
    max-width: 850px;
    margin: 0 auto;
    color: white;
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .contact p {
    max-width: 680px;
    margin: 1.3rem auto 0;
    color: #d8ecff;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 50px;
    padding: 0 1.45rem;
    border-radius: 999px;
    background: white;
    color: #1f5f94;
    font-weight: 950;
    text-decoration: none;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.16);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .primary-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 700px) {
    .contact {
      padding-left: 6%;
      padding-right: 6%;
    }

    .contact h2 {
      font-size: clamp(2.4rem, 12vw, 4rem);
    }
  }
</style>